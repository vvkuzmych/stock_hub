# Email Service Configuration

# Server
SERVER_PORT=8083

# Database (to fetch users/orders from stock_hub_trade)
DATABASE_DSN=host=localhost port=5432 user=postgres password=postgres dbname=stock_hub sslmode=disable

# Mock Mode (for development without real SMTP)
# Set to "true" to skip actual email sending and just log to console
MOCK_EMAIL=true

# ============================================
# SMTP Configuration (choose one)
# ============================================

# Option 1: Mailtrap (RECOMMENDED for testing) 🌟
# Sign up at https://mailtrap.io/ (FREE)
# All emails go to online inbox - safe for testing!
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your-mailtrap-username
# SMTP_PASSWORD=your-mailtrap-password

# Option 2: Gmail (for production)
# Use App Password: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-16-char-app-password

# Option 3: SendGrid, AWS SES, etc.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key

# Email sender info
FROM_EMAIL=noreply@stockhub.com
FROM_NAME=Stock Hub
